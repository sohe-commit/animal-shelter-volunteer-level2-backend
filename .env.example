# 이 파일을 복사해서 .env를 만들고 값을 채워 주세요. (.env는 GitHub에 올라가지 않습니다)

# PostgreSQL 접속 주소 (Render 대시보드의 External/Internal Database URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
# 내 컴퓨터의 PostgreSQL처럼 SSL이 없는 DB를 쓸 때만 false
# DATABASE_SSL=false

PORT=4000
# 백엔드를 부를 수 있는 프론트엔드 주소 (여러 개면 쉼표로 구분)
FRONTEND_ORIGIN=http://localhost:3000
